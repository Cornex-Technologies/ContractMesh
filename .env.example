# ==============================================================================
# CodeClaim Environment Configuration Template (.env.example)
# ==============================================================================

# CockroachDB Cloud Connection String (Required for live database operations)
# Example: postgresql://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full
COCKROACH_DATABASE_URL="postgresql://<username>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full"

# Webhook Authentication (Required in production)
CHANGEFEED_WEBHOOK_SECRET="generate-a-secure-random-secret-key-here"

# AWS Configuration (Amazon Bedrock & S3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v1"
# Set cohere_v4 when using cohere.embed-v4:0. Keep 1536 to match the current vector columns.
BEDROCK_EMBEDDING_PROVIDER="titan"
EMBEDDING_DIMENSION=1536
S3_RECEIPT_BUCKET="codeclaim-audit-receipts"

# Coordination Settings
# Safe default is False. Set to true only for scripted 3-minute video demo flows.
DEMO_AUTO_RECONCILE=false
IS_DEMO_MODE=false
COORDINATOR_HOST="0.0.0.0"
COORDINATOR_PORT=8000
MCP_CLUSTER_ID=""
COORDINATOR_API_KEY="generate-a-different-secure-random-secret-key"
# Used only for callbacks to webhook-mode harness registrations. Prefer a secrets manager in production.
HARNESS_DISPATCH_WEBHOOK_SECRET=""
# A local CodeClaim MCP process authenticates as one registered harness using these environment-only values.
MCP_HARNESS_ID=""
MCP_HARNESS_TOKEN=""

# Optional Slack observability projection. Slack failures never affect coordinator correctness.
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=""
# Keep false unless checkpoint-level noise is useful for a short demo.
SLACK_NOTIFY_CHECKPOINTS=false
